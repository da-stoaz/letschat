{
  "name": "letschat",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "version:bump": "bun scripts/bump-version.ts",
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "build:local": "bun run build",
    "tauri:build:local": "tauri build",
    "downloads:sync": "bun scripts/sync-downloads.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "core-api:dev": "ASPNETCORE_ENVIRONMENT=Development dotnet run --project core-api/src/CoreApi/CoreApi.csproj",
    "core-api:dev:lan": "bun --no-env-file scripts/core-api-lan.ts",
    "core-api:test": "dotnet test core-api/CoreApi.slnx",
    "core-api:migrate": "dotnet run --project core-api/tools/CoreApi.Migrator -- --sqlite ./legacy-auth.db",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/generated --module-path server --yes",
    "spacetime:publish": "spacetime publish --server http://localhost:4300 letschat --module-path server",
    "spacetime:reset": "spacetime publish --server http://localhost:4300 letschat --module-path server --delete-data --yes",
    "services:up": "docker compose -f docker-compose.dev.yml up -d",
    "services:down": "docker compose -f docker-compose.dev.yml down",
    "services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "services:reset": "docker compose -f docker-compose.dev.yml down -v",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@livekit/krisp-noise-filter": "^0.4.4",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.46.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "spacetimedb": "~2.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "1.19.15",
    "baseline-browser-mapping": "2.11.24",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.0",
    "fast-uri": "3.1.6",
    "hono": "4.13.8",
    "ip-address": "10.7.2",
    "js-yaml": "5.4.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "qs": "6.16.0"
  }
}
