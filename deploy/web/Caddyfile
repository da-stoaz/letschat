# Static file server for the LetsChat web SPA (inside the `web` container).
# TLS + public exposure are handled upstream by the reverse proxy / tunnel; this
# listens plain HTTP on :80 and is reached by service name `web:80`.

:80 {
	root * /srv
	encode zstd gzip

	# ── Security headers ────────────────────────────────────────────────────────
	# The CSP is DERIVED FROM THIS INSTANCE'S PUBLIC URLS — DISCOVERY_AUTH_URL,
	# DISCOVERY_SPACETIMEDB_URI, DISCOVERY_LIVEKIT_URL and MINIO_PUBLIC_ENDPOINT.
	# entrypoint.sh turns each into {$<SERVICE>_HTTP} / {$<SERVICE>_WS} origins with
	# the URL's own TLS-ness, and Caddy fills `{$VAR}` from the environment.
	#
	# ENFORCED (BUG_ANALYSIS E4). Verified in headless Chrome against the dev stack
	# with this exact policy: sign-in, SpacetimeDB sync, messages, a MinIO image
	# and a LiveKit voice call, with zero violations. If a deployment ever needs
	# to debug a block, rename the header to `Content-Security-Policy-Report-Only`
	# temporarily. `script-src 'self'` (no 'unsafe-inline') is the key anti-XSS
	# lever — session tokens live in localStorage; `connect-src` limited to your
	# own services is the anti-exfil lever.
	#
	# {$CHAT_HTTP} next to {$CHAT_WS} is REQUIRED: the SpacetimeDB SDK fetches
	# /v1/identity/websocket-token over HTTP(S) before opening the socket.
	#
	# 'unsafe-eval' is REQUIRED, not optional: the SpacetimeDB SDK generates its
	# BSATN row deserializers at runtime with `Function("reader", ...)` (see
	# node_modules/spacetimedb .../index.browser.mjs). Remove it and the realtime
	# client cannot decode any row — the app can't connect. It also covers the
	# Krisp WASM (supersedes 'wasm-unsafe-eval'). We still withhold 'unsafe-inline',
	# so injected inline <script> / event-handler XSS stays blocked.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$FILES_HTTP}; font-src 'self' data:; media-src 'self' blob: {$FILES_HTTP}; frame-src {$FILES_HTTP}; worker-src 'self' blob:; connect-src 'self' {$AUTH_HTTP} {$CHAT_HTTP} {$CHAT_WS} {$LIVEKIT_HTTP} {$LIVEKIT_WS} {$FILES_HTTP}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# HSTS is set at the TLS edge (reverse proxy / tunnel), not here — this
		# container listens plain HTTP behind that edge.
		-Server
	}

	# Content-hashed bundle assets are immutable — cache them aggressively.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The HTML entry must never be cached, so new deploys are picked up at once;
	# nor may config.js, which carries this instance's settings.
	@html path / /index.html /config.js
	header @html Cache-Control "no-cache"

	# SPA fallback: unknown paths (client-side routes like /app, /join) serve the
	# app shell so BrowserRouter can take over.
	try_files {path} /index.html
	file_server
}
