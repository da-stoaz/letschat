# Static file server for the LetsChat web SPA (inside the `web` container).
# TLS + public exposure are handled upstream by the reverse proxy / tunnel; this
# listens plain HTTP on :80 and is reached by service name `web:80`.

:80 {
	root * /srv
	encode zstd gzip

	# ── Security headers ────────────────────────────────────────────────────────
	# The CSP is DERIVED FROM THIS INSTANCE'S SERVICE DOMAINS — the same env vars
	# the edge reverse-proxy uses (AUTH_DOMAIN, CHAT_DOMAIN, LIVEKIT_DOMAIN,
	# FILES_DOMAIN), injected into this container via docker-compose. Caddy fills
	# `{$VAR}` from the container environment at startup.
	#
	# Shipped in REPORT-ONLY first: the browser reports what it *would* block (dev
	# console + any report collector) WITHOUT breaking anything. Once the reports
	# are clean for your deployment, rename the header to `Content-Security-Policy`
	# to enforce. `script-src 'self'` (no 'unsafe-inline') is the key anti-XSS
	# lever; `connect-src` limited to your own services is the anti-exfil lever.
	#
	# 'unsafe-eval' is REQUIRED, not optional: the SpacetimeDB SDK generates its
	# BSATN row deserializers at runtime with `Function("reader", ...)` (see
	# node_modules/spacetimedb .../index.browser.mjs). Remove it and the realtime
	# client cannot decode any row — the app can't connect. It also covers the
	# Krisp WASM (supersedes 'wasm-unsafe-eval'). We still withhold 'unsafe-inline',
	# so injected inline <script> / event-handler XSS stays blocked.
	header {
		Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$FILES_DOMAIN}; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://{$AUTH_DOMAIN} wss://{$CHAT_DOMAIN} https://{$LIVEKIT_DOMAIN} wss://{$LIVEKIT_DOMAIN} https://{$FILES_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# HSTS is set at the TLS edge (reverse proxy / tunnel), not here — this
		# container listens plain HTTP behind that edge.
		-Server
	}

	# ── Runtime instance configuration ──────────────────────────────────────────
	# Overrides the no-op /config.js placeholder shipped inside the bundle, so ONE
	# published letschat-web image can serve any instance. Baking the connect URL
	# in at build time made the image single-tenant — which is why it could not be
	# published at all, and why every operator had to compile the frontend on
	# their own deployment target.
	#
	# Never cached: an operator changing WEB_CONNECT_URL and restarting the
	# container must take effect on the next load, not after a cache expiry.
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.__LETSCHAT_CONFIG__={connectUrl:"{$WEB_CONNECT_URL:}",wsCompression:"{$WEB_WS_COMPRESSION:gzip}"};` 200
	}

	handle {
		# Content-hashed bundle assets are immutable — cache them aggressively.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# The HTML entry must never be cached, so new deploys are picked up at once.
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# SPA fallback: unknown paths (client-side routes like /app, /join) serve
		# the app shell so BrowserRouter can take over.
		try_files {path} /index.html
		file_server
	}
}
