---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Callout from "@/components/Callout.astro";

const paths = [
  {
    href: "/self-hosting/cloudflare-tunnel",
    label: "Path A",
    title: "Cloudflare Tunnel",
    summary: "Web traffic reaches your server through a Cloudflare Tunnel, so nothing listens on 80/443. Only the two LiveKit media ports are forwarded.",
    bestFor: "home servers where you'd rather not expose a web server directly.",
    tags: ["No open 80/443", "Cloudflare ingress"],
  },
  {
    href: "/self-hosting/caddy",
    label: "Path B",
    title: "Caddy reverse proxy",
    summary: "Caddy runs on your host, gets TLS certificates automatically and routes each hostname to its container.",
    bestFor: "servers with a public IP where opening 80/443 is fine.",
    tags: ["Direct HTTPS", "Automatic TLS"],
  },
];

const services = [
  { name: "core-api", host: "auth", role: "Accounts, sign-in, the admin panel, and the discovery file apps read on startup (/.well-known/letschat.json)." },
  { name: "SpacetimeDB", host: "chat", role: "Realtime database for spaces, channels, messages and presence." },
  { name: "LiveKit", host: "lk", role: "Voice, video and screen sharing." },
  { name: "MinIO", host: "files", role: "File storage. Defaults: 500 MiB per file and 2 GiB per user per day; change them in the admin panel." },
  { name: "Web client", host: "app", role: "Optional browser client, so people can join without installing the desktop app." },
  { name: "PostgreSQL", host: null, role: "Accounts and an archive copy of every message, kept current by the archive worker." },
];

const mistakes = [
  ["Voice joins but no audio", "LiveKit media ports not forwarded", "Forward <code>44382/udp</code> (primary) and <code>44381/tcp</code> (fallback) to the host"],
  ["Setup discovery fails", "<code>auth.&lt;domain&gt;</code> not serving <code>/.well-known/letschat.json</code>", "Tunnel: <code>auth → core-api:8787</code>; Caddy: check <code>AUTH_DOMAIN</code> and DNS"],
  ["Browser or desktop can't upload or download files", "<code>MINIO_CORS_ALLOW_ORIGIN</code> narrowed to one origin", "Set it back to <code>*</code>. The desktop app's origin is <code>tauri://localhost</code>, not the web one"],
  ["Upload/download errors", "Wrong <code>MINIO_PUBLIC_ENDPOINT</code>", "Set it to the public <code>https://files…</code> endpoint clients can reach"],
  ["Upload part fails with <code>413</code> (tunnel)", "Cloudflare caps each proxied request body at 100 MB (Free/Pro)", "Keep the multipart part size at or below 90 MiB in the admin panel. Older clients send one PUT and stay subject to the cap"],
  ["Caddy certificate issuance fails", "Cloudflare proxy enabled, or 80/443 closed", "Use DNS-only records and open <code>80/tcp</code> and <code>443/tcp</code>"],
  ["LiveKit setup fails immediately", "Wrong signalling scheme (<code>ws://</code> vs <code>wss://</code>)", "Both paths use <code>wss://lk…</code>; plain <code>ws://</code> is dev-only"],
  ["SpacetimeDB connect timeout", "<code>module-init</code> failed or SpacetimeDB not yet healthy", "Check <code>docker logs letschat-module-init</code>; it retries automatically"],
  ["<code>module-init</code> keeps restarting after an upgrade", "Its log says the changes <em>will BREAK existing clients</em>; the old module keeps serving", "Read the release's Breaking Changes notes, then accept once with the <code>break-clients</code> command in <code>docs/DEPLOYMENT.md</code> (\"Upgrades that break existing clients\")"],
];
---

<Layout
  title="LetsChat Self-Hosting Guide"
  description="Self-host LetsChat with Docker Compose behind Cloudflare Tunnel or a Caddy reverse proxy."
>
  <SiteHeader active="self-hosting" />

  <main class="max-w-7xl mx-auto px-5 sm:px-6 py-14 space-y-14">
    <section>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight mb-3">Self-host LetsChat</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl">
        One Docker Compose stack runs chat, sign-in, voice and file storage. People connect with the desktop app,
        or in the browser if you host the web client. Pick how HTTPS reaches your server, then follow that guide.
      </p>
    </section>

    <section class="space-y-5">
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Choose a deployment path</h2>
        <p class="text-muted-foreground">Both paths deploy the same stack. They differ only in how traffic reaches it.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {paths.map((path) => (
          <a href={path.href} class="path-card">
            <p class="path-label">{path.label}</p>
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <p><strong>Best for</strong> {path.bestFor}</p>
            <div class="flex flex-wrap items-center gap-2 pt-1">
              {path.tags.map((tag) => <span class="tag">{tag}</span>)}
              <span class="path-cta">Read the guide →</span>
            </div>
          </a>
        ))}
      </div>
      <Callout type="note" title="Upgrading an existing server?">
        Check <a href="/breaking-changes" class="text-foreground underline underline-offset-4">Breaking Changes</a> first
        for anything you need to migrate.
      </Callout>
    </section>

    <section class="space-y-5">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">What's in the stack</h2>
      <dl class="stack-grid">
        {services.map((service) => (
          <div>
            <dt>
              {service.name}
              {service.host ? <code>{service.host}.&lt;domain&gt;</code> : <span class="text-xs text-muted-foreground">internal</span>}
            </dt>
            <dd>{service.role}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="space-y-5">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">Troubleshooting</h2>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Problem</th>
              <th>Likely cause</th>
              <th>Fix</th>
            </tr>
          </thead>
          <tbody>
            {mistakes.map(([problem, cause, fix]) => (
              <tr>
                <td set:html={problem} />
                <td set:html={cause} />
                <td set:html={fix} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border: 1px solid oklch(1 0 0 / 0.13);
    border-radius: 1rem;
    padding: 1.4rem;
    background: linear-gradient(175deg, oklch(0.22 0.01 245 / 0.95), oklch(0.19 0.01 245 / 0.92));
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .path-card:hover {
    transform: translateY(-2px);
    border-color: oklch(0.75 0.1 220 / 0.45);
  }

  .path-card h3 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .path-card p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .path-card strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .path-card .path-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-cyan);
  }

  .tag {
    border: 1px solid oklch(1 0 0 / 0.14);
    border-radius: 9999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    color: var(--color-muted-foreground);
  }

  .path-cta {
    margin-left: auto;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent-blue);
  }

  .stack-grid {
    display: grid;
    gap: 1px;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-border);
  }

  @media (min-width: 640px) {
    .stack-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .stack-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .stack-grid > div {
    padding: 1rem 1.1rem;
    background: oklch(0.19 0.01 245);
  }

  .stack-grid dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .stack-grid dt code {
    font-size: 0.72rem;
    font-weight: 400;
  }

  .stack-grid dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-muted-foreground);
  }
</style>
