---
import PageLayout from "@/layouts/PageLayout.astro";
import { GITHUB_DISCUSSIONS, GITHUB_ISSUE_NEW } from "@/lib/site";

const updatedAt = "November 24, 2026";

// Delivered and merged to main.
const shipped = [
  {
    id: "Plan 1",
    focus: "Admin Control Panel & Identity",
    blurb: "An authoritative .NET auth backend and a browser-based admin panel.",
    items: [
      "core-api rebuilt on .NET 10 / ASP.NET Core Identity backed by PostgreSQL.",
      "Email verification, per-IP rate limiting, and an admin approval workflow.",
      "Razor admin panel — users, pending queue, system config, audit log — on a non-public listener.",
      "Password reset end-to-end and production deployment cutover.",
    ],
  },
  {
    id: "Plan 1.5",
    focus: "Space Permissions & Discovery",
    blurb: "Control over who can create spaces, and a public surface to find and join them.",
    items: [
      "Configurable space-creation policy, propagated into the chat-domain admin gate.",
      "Opt-in discoverability with descriptions and topic tags; a Discover panel with search and tag filters.",
      "Request-to-join flow for invite-only spaces — approve, decline, and re-request.",
      "Per-owner anti-spam quota and instance-admin moderation (un-list any space).",
    ],
  },
  {
    id: "Plan 1.6",
    focus: "Hosted Web Client & SpacetimeDB 2.5",
    blurb: "LetsChat in the browser, plus the realtime engine moved onto the current release line.",
    items: [
      "Hosted browser client at app.<domain> — single-tenant, auto-discovers its instance, no install.",
      "Reliability-first WebSocket compression with automatic downgrade so a browser can never get stranded.",
      "SpacetimeDB bumped 2.2 → 2.5 in lockstep (CLI, npm SDK, Rust crate, server image).",
      "MinIO browser CORS, web join links, and a dismissable \"also on desktop\" prompt.",
    ],
  },
  {
    id: "Identity Authority Inversion",
    focus: "core-api as the OIDC issuer",
    blurb: "One account, one permanent identity — derived rather than stored, and immune to database wipes.",
    items: [
      "core-api issues the realtime-database access token as an OIDC provider; the database verifies it against a published JWKS.",
      "Identities derive deterministically from issuer + account, so they survive a wipe and never need relinking.",
      "Retired the stale-token and relink bug class outright — tokens are minted on demand and never stored.",
      "Breaking deploy: SPACETIME_OIDC_PRIVATE_KEY must be set before upgrading, or core-api refuses to start.",
    ],
  },
  {
    id: "Plan 2, Part A",
    focus: "Durability & Cold Archive",
    blurb: "Nothing is lost: every message mirrored to PostgreSQL, and destructive migrations made survivable.",
    items: [
      "A .NET replication worker mirrors the chat domain into a PostgreSQL cold archive.",
      "Destructive schema migrations become a safe wipe-and-rebuild from the archive.",
      "Scheduled backups of all data, wired into the production compose stack.",
      "Part B (evicting cold history from the hot set to cap server RAM) remains ahead.",
    ],
  },
  {
    id: "v1.0",
    focus: "1.0 Release",
    blurb: "The first stable release — no half-finished surfaces left in the UI, and a deployment you can upgrade and roll back.",
    items: [
      "Pinned messages and in-channel message search — the last placeholder buttons are now live features.",
      "Voice presence made server-owned: presence rows are connection-scoped and swept on disconnect, ending the join/leave desync.",
      "The realtime module owns id allocation, so rebuilding from the cold archive can no longer collide with auto-increment.",
      "Production images pinned by LETSCHAT_VERSION with immutable version and commit tags, published for amd64 and arm64, plus a documented upgrade/rollback runbook.",
    ],
  },
  {
    id: "v1.1 – v1.6",
    focus: "Attachments, Calls & Compatibility",
    blurb: "Files and calls grew up, two security reviews closed, and old and new versions now fail clearly instead of silently.",
    items: [
      "Object-storage attachments with multipart uploads, daily and stored-byte upload limits, video posters and HLS playback.",
      "Call quality: local RNNoise or DeepFilterNet noise suppression on desktop and web, screen sharing up to 1080p/60 with simulcast, and master and per-person call volume.",
      "Every open security review finding closed; the public database API is restricted to the chat socket and token exchange.",
      "Client/backend compatibility: apps check the server's protocol before connecting, and releases are gated on the full client contract and an in-place upgrade of the previous release.",
      "Invite links unfurl as a preview card in other messengers and open the desktop app straight at the invite.",
    ],
  },
  {
    id: "v1.7",
    focus: "Desktop auto-update",
    blurb: "The desktop app updates itself, but never ahead of the servers it connects to.",
    items: [
      "Each saved server recommends a client version; the app offers the highest one and installs it when you restart, so a call is never cut off.",
      "Updates come from a signed feed checked against a key built into the app. Downgrades and unpublished releases are never offered.",
      "Operators can hand out a client fix early with RECOMMENDED_CLIENT_VERSION.",
      "Apps older than 1.6.5 have no updater and need one manual update.",
    ],
  },
];

// Ahead, roughly in priority order. `status` picks the group on the page:
// Now = in progress, Next = up next, Planned, Deferred = later.
const upcoming = [
  {
    id: "Release",
    focus: "Signed Windows installers",
    priority: "P1",
    status: "Now",
    effort: "~1 week after approval",
    goals: [
      "Sign every Windows installer so SmartScreen and antivirus show a verified publisher instead of \"unknown publisher\".",
      "Free for open source through the SignPath Foundation. The application is prepared; release CI is wired up once it is approved.",
      "Re-sign the updater files after Authenticode signing, so Windows auto-updates keep verifying.",
      "SmartScreen warnings fade gradually: the free certificate builds reputation over time.",
    ],
  },
  {
    id: "Operations",
    focus: "One-command server upgrades",
    priority: "P0",
    status: "Next",
    effort: "~2–4 weeks",
    goals: [
      "Upgrading a self-hosted server is still manual: download the new compose files, pull the images and restart.",
      "Turn that into one safe command. (The desktop half of over-the-air updates shipped in 1.7.)",
    ],
  },
  {
    id: "Groups",
    focus: "Group DMs",
    priority: "P2",
    status: "Next",
    effort: "~4 weeks",
    goals: [
      "Group conversations of up to 10 friends, with owner controls for members and naming.",
      "Attachments and group calls, archived and restorable like every other conversation.",
      "Lands before end-to-end encryption so group chats can be encrypted from the start.",
    ],
  },
  {
    id: "Calls",
    focus: "Voice & media quality",
    priority: "P1",
    status: "Planned",
    effort: "~4 weeks",
    goals: [
      "Tune camera video for weak connections (calls already use adaptive stream and dynacast).",
      "Verify layer switching between real clients, and call quality on headsets and installed desktop builds.",
    ],
  },
  {
    id: "Sounds",
    focus: "App sounds",
    priority: "P2",
    status: "Planned",
    effort: "~2 weeks",
    goals: [
      "Sounds for joining and leaving calls, yourself or others, and for mute, deafen, camera and screen share.",
      "A ringing tone while your call is waiting for an answer; the incoming ring gets a proper sound.",
      "A sound for new notifications, following the existing notification settings and quiet hours.",
      "One volume and on/off switches per sound group, played on your selected call output where supported.",
    ],
  },
  {
    id: "Spaces",
    focus: "Space operations & limits",
    priority: "P1",
    status: "Planned",
    effort: "~2 months",
    goals: [
      "Verify the per-user and instance storage limits and >100 MB multipart uploads on a real deployment behind Cloudflare Tunnel; both shipped in v1.1.",
      "Resumable downloads, and continuing an upload after the app restarts.",
      "Per-space roles and access management (Discord-style), and per-space storage quotas.",
      "Drop the core-api↔SpacetimeDB admin-identity coupling; add operator-facing server logging.",
    ],
  },
  {
    id: "Storage",
    focus: "Storage tiering, Part B: eviction",
    priority: "P2",
    status: "Planned",
    effort: "~4 weeks",
    goals: [
      "Keep only the newest 200 messages per channel and DM in SpacetimeDB, and serve older history from the PostgreSQL archive.",
      "Starts when production measurements show SpacetimeDB memory or history paging nearing the host's budget, not before.",
      "Already in place: the archive mirror, safe rebuilds and backups (Part A), and clients that page older history on scroll.",
    ],
  },
  {
    id: "Design",
    focus: "Full UI redesign",
    priority: "P2",
    status: "Planned",
    effort: "~2 months",
    goals: [
      "Deliberate ground-up visual redesign rather than incremental patches.",
      "Profile cards, and right-click menus everywhere; today only call participants have one, for per-person volume.",
      "A custom window title bar.",
    ],
  },
  {
    id: "Security",
    focus: "End-to-end encryption",
    priority: "P2",
    status: "Planned",
    effort: "Multi-month",
    goals: [
      "Opt-in per conversation: encrypted and plaintext DMs, groups and channels coexist; turning it on is one-way.",
      "Encrypt DMs first, then attachments and calls (LiveKit insertable streams), then spaces.",
      "Per-conversation keys wrapped per device; all decryption happens on-device.",
      "Key epochs rotate on membership change for re-readable, multi-device history.",
    ],
  },
  {
    id: "Search",
    focus: "Search",
    priority: "P2",
    status: "Planned",
    effort: "~3 weeks",
    goals: [
      "Search full history across spaces, DMs and groups. Today search covers only the messages loaded in the open channel.",
      "Runs on-device over decrypted messages, so it works in encrypted conversations; scheduled after end-to-end encryption for that reason.",
    ],
  },
  {
    id: "Ideas",
    focus: "Later or idea stage",
    priority: "Idea",
    status: "Deferred",
    effort: "Unscheduled",
    goals: [
      "Localisation (i18n), agreed for a later milestone.",
      "Native mobile app, public integration API, and MCP integration.",
      "One app connected to several servers at once, and an on-device message cache for offline reading and faster start.",
    ],
  },
];

const groups = [
  { status: "Now", title: "In progress" },
  { status: "Next", title: "Up next" },
  { status: "Planned", title: "Planned" },
  { status: "Deferred", title: "Later" },
].map((group) => ({ ...group, items: upcoming.filter((m) => m.status === group.status) }));
---

<PageLayout
  title="LetsChat Roadmap | Shipped and Planned Features"
  description="LetsChat roadmap: shipped milestones and the plans ahead — signed Windows installers, one-command server upgrades, storage tiering, call quality, a full UI redesign, and end-to-end encryption."
  active="roadmap"
  heading="Roadmap"
>
  <Fragment slot="lead">
    <p>
      LetsChat is built plan by plan, each one building on the last. There are no calendar dates;
      plans land in order as they're finished.
    </p>
    <p class="text-sm">Last updated {updatedAt}</p>
  </Fragment>

  <section class="space-y-10">
    {groups.map((group) => (
      <div class="space-y-4">
        <h2 class={`group-title group-${group.status.toLowerCase()}`}>
          {group.title}
          <span>{group.items.length}</span>
        </h2>
        <div class="timeline-list">
          {group.items.map((milestone) => (
            <article class={`card timeline-card card-${group.status.toLowerCase()}`}>
              <div class="timeline-head">
                <div>
                  <p class="timeline-window">{milestone.id}</p>
                  <h3>{milestone.focus}</h3>
                </div>
                <div class="timeline-meta">
                  <span class={`chip priority-${milestone.priority.toLowerCase()}`}>{milestone.priority}</span>
                  <span class="chip">{milestone.effort}</span>
                </div>
              </div>
              <ul class="timeline-goals">
                {milestone.goals.map((goal) => <li>{goal}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="space-y-4">
    <h2 class="group-title group-shipped">Shipped <span>{shipped.length}</span></h2>
    <div class="shipped-grid">
      {[...shipped].reverse().map((milestone) => (
        <article class="card shipped-card">
          <p class="timeline-window">{milestone.id}</p>
          <h3>{milestone.focus}</h3>
          <p class="shipped-blurb">{milestone.blurb}</p>
          <details>
            <summary>What shipped</summary>
            <ul class="timeline-goals">
              {milestone.items.map((item) => <li>{item}</li>)}
            </ul>
          </details>
        </article>
      ))}
    </div>
  </section>

  <section class="feedback-strip">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight mb-1">Shape what comes next</h2>
      <p class="text-sm text-muted-foreground">Ideas go to GitHub Discussions; bugs that block you go to the issue tracker.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href={GITHUB_DISCUSSIONS} target="_blank" rel="noopener" class="feedback-primary">Request a feature</a>
      <a href={GITHUB_ISSUE_NEW} target="_blank" rel="noopener" class="feedback-secondary">Report a bug</a>
    </div>
  </section>
</PageLayout>

<style>
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .group-title::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--dot, oklch(0.6 0.01 250));
  }

  .group-title span {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-muted-foreground);
    border: 1px solid oklch(1 0 0 / 0.14);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }

  .group-now { --dot: var(--color-accent-cyan); }
  .group-next { --dot: var(--color-accent-blue); }
  .group-shipped { --dot: oklch(0.72 0.14 150); }

  .group-now::before {
    box-shadow: 0 0 0 5px oklch(0.79 0.13 210 / 0.18);
  }

  .timeline-list {
    position: relative;
    display: grid;
    gap: 0.8rem;
  }

  .timeline-list::before {
    content: "";
    position: absolute;
    left: 0.27rem;
    top: 0.65rem;
    bottom: 0.65rem;
    width: 2px;
    background: oklch(1 0 0 / 0.1);
    border-radius: 999px;
  }

  .timeline-card {
    position: relative;
    margin-left: 1.5rem;
    padding: 1.1rem 1.2rem;
  }

  .timeline-card::before {
    content: "";
    position: absolute;
    left: calc(-1.5rem + 0.05rem);
    top: 1.35rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: oklch(0.45 0.01 250);
  }

  .card-now {
    border-color: oklch(0.79 0.13 210 / 0.4);
    background:
      radial-gradient(600px 200px at 100% 0%, oklch(0.79 0.13 210 / 0.1), transparent 70%),
      linear-gradient(175deg, oklch(0.21 0.01 245 / 0.95), oklch(0.18 0.01 245 / 0.92));
  }

  .card-now::before { background: var(--color-accent-cyan); }
  .card-next { border-color: oklch(0.63 0.18 240 / 0.4); }
  .card-next::before { background: var(--color-accent-blue); }
  .card-deferred { opacity: 0.8; }

  .timeline-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.7rem;
  }

  .timeline-window {
    margin: 0 0 0.2rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted-foreground);
  }

  .timeline-head h3,
  .shipped-card h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .timeline-meta {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .priority-p0 {
    background: oklch(0.66 0.2 25 / 0.16);
    color: oklch(0.88 0.08 30);
  }

  .priority-p1 {
    background: oklch(0.76 0.12 85 / 0.2);
    color: oklch(0.9 0.07 100);
  }

  .priority-p2 {
    background: oklch(0.62 0.1 235 / 0.16);
    color: oklch(0.84 0.06 230);
  }

  .timeline-goals {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.4rem;
    color: var(--color-muted-foreground);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .shipped-grid {
    display: grid;
    gap: 0.8rem;
  }

  .shipped-card {
    padding: 1.1rem 1.2rem;
  }

  .shipped-blurb {
    margin: 0.4rem 0 0.7rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted-foreground);
  }

  .shipped-card summary {
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent-blue);
  }

  .shipped-card details[open] summary {
    margin-bottom: 0.6rem;
  }

  .feedback-strip {
    border: 1px solid oklch(1 0 0 / 0.14);
    border-radius: 1.25rem;
    padding: 1.4rem;
    background:
      linear-gradient(165deg, oklch(0.21 0.02 240 / 0.96), oklch(0.17 0.01 245 / 0.92)),
      radial-gradient(700px 280px at 90% 0%, oklch(0.72 0.1 220 / 0.2), transparent 66%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .feedback-primary,
  .feedback-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    padding: 0.7rem 1rem;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .feedback-primary {
    background: var(--color-accent-blue);
    color: white;
  }

  .feedback-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
  }

  .feedback-secondary:hover {
    border-color: var(--color-border-hover);
    color: var(--color-foreground);
  }

  @media (min-width: 900px) {
    .shipped-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .timeline-head {
      flex-direction: column;
    }
  }
</style>
