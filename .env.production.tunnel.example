# LetsChat production env (Cloudflare Tunnel track)
# Copy to .env in repo root before starting production services.
# Generate secrets with:
#   openssl rand -hex 32
#   openssl rand -base64 32
#
# ─────────────────────────────────────────────────────────────────────────────
# Two kinds of settings live in this file:
#
#   • REQUIRED (env-only) — secrets, infrastructure pointers, deploy-time
#     identity. Read once at startup. Changes here require a restart.
#
#   • FIRST-RUN DEFAULTS — operational policy (registration mode, rate
#     limits, SMTP). On a fresh deployment these seed a row in the runtime
#     SystemConfig table. AFTER that, the live values come from the admin
#     panel at /admin/config and these env vars are IGNORED. Edit them via
#     the panel; the env file becomes documentation, not configuration.
# ─────────────────────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                       REQUIRED — env only                                 ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Release pinning ──────────────────────────────────────────────────────────
# Which LetsChat release this deployment runs (applies to the core-api, module,
# archive-worker and web images together; the third-party images are pinned in
# docker-compose.prod.base.yml). Every release publishes
# immutable version tags, so pinning makes upgrades explicit:
#   LETSCHAT_VERSION=1.0.0    # upgrade: raise it, then docker compose pull && up -d
# Rollback: restore the previous .env AND deployment files with the retained
# images; changing this version alone is insufficient. See DEPLOYMENT.md.
# `latest` follows the newest release on every pull (the pre-1.0 behaviour).
LETSCHAT_VERSION=latest

# ── Auth backend (core-api / ASP.NET Core Identity + PostgreSQL) ─────────────
AUTH_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Private key core-api signs the SpacetimeDB access token with (RS256).
# SpacetimeDB verifies tokens against the matching public key, which core-api
# publishes at /.well-known/jwks.json — so this key is what makes chat logins
# trustworthy. A PEM is multi-line and .env values are not, so supply it
# base64-encoded (a PEM file path also works, if you mount secrets as files):
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
#
# Generate ONCE and keep it. Replacing it invalidates every access token already
# issued, so every user has to sign in again (accounts and data are unaffected —
# identities do not depend on this key). core-api refuses to start without it.
SPACETIME_OIDC_PRIVATE_KEY=change-me-see-comment-above

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=letschat
POSTGRES_DB=auth
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# ── Cold archive (durability) ────────────────────────────────────────────────
# The archive-worker mirrors all durable SpacetimeDB rows into this database,
# in the SAME Postgres instance as auth. This second copy is what makes a
# destructive SpacetimeDB migration survivable instead of losing all history.
# The default is fine; change it only if `archive` collides with something.
#
# ⚠️ Replication does NOT start until an instance admin registers the worker's
# identity once — see "Cold archive" in DEPLOYMENT.md.
ARCHIVE_DB=archive

# ── Bootstrap admin (first run only) ─────────────────────────────────────────
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Compose hands this pair to LiveKit (LIVEKIT_KEYS) and to core-api, so there is
# nothing to copy into livekit/config.prod.yaml.
LIVEKIT_API_KEY=letschat-prod
LIVEKIT_API_SECRET=change-me-generate-with-openssl-rand-base64-32

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# FILES_DOMAIN below determines the presigned URLs returned by core-api.
# Files above UPLOAD_PART_SIZE_MIB use multipart PUTs. Keep each part below
# Cloudflare's 100 MB per-request cap on Free/Pro (the API accepts at most
# 90 MiB parts). Downloads are not affected by this request-body cap.
# CORS for the presigned URLs every client uses — it gates UPLOADS as well as
# downloads. The desktop app is NOT exempt: the Tauri webview enforces CORS and
# its origin is tauri://localhost (macOS/Linux) or http://tauri.localhost
# (Windows). Pinning this to the web origin alone silently blocks every desktop
# upload (profile picture, chat attachment) at the preflight.
#
# Keep "*" unless you have a specific reason not to — the presigned signature,
# not the Origin header, is what authorises the request. If you do pin it, list
# every client origin (comma-separated), not just the web one:
#   MINIO_CORS_ALLOW_ORIGIN=https://app.example.com,tauri://localhost,http://tauri.localhost
MINIO_CORS_ALLOW_ORIGIN=*
UPLOAD_PART_SIZE_MIB=64
UPLOAD_MAX_FILE_SIZE_MIB=500
# Seeded once into the admin panel. 0 means unlimited stored bytes, not
# unlimited physical MinIO disk space; a full volume still rejects writes.
DAILY_UPLOAD_QUOTA_MIB=2048
USER_STORAGE_LIMIT_MIB=0
INSTANCE_STORAGE_LIMIT_MIB=0

# ── Public hostnames — enter each once (both deployment tracks) ───────────────
# Hostnames only, no scheme or path. Compose builds the public service URLs
# from these; Caddy, discovery, invite links and the browser share the values.
# Point DNS (or your tunnel routes) at the matching service.
AUTH_DOMAIN=auth.example.com
CHAT_DOMAIN=chat.example.com
FILES_DOMAIN=files.example.com
LIVEKIT_DOMAIN=lk.example.com
# Leave empty for a desktop-only deployment (no public browser site).
APP_DOMAIN=app.example.com
# HTTPS by default. Only for a plain-HTTP LAN deployment: PUBLIC_SCHEME=http

# ── Hosted web client ─────────────────────────────────────────────────────────
# Caddy serves /config.js directly; the browser connects to the derived auth
# URL. No VITE_WEB_CONNECT_URL or DISCOVERY_* values to repeat here.
# WebSocket compression for the DB stream in browsers: "gzip" (default, bandwidth
# win) or "none". The client also auto-downgrades to none if a gzip socket fails.
VITE_WEB_WS_COMPRESSION=gzip


# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# ONLY used by the bundled `cloudflared` service in
# docker-compose.prod.tunnel.yml. Create a named tunnel in Cloudflare Zero
# Trust and paste its token here.
#
# Already running cloudflared (or another reverse proxy) natively on this host?
# Don't run the tunnel overlay at all — start the base stack on its own and
# point your existing connector at the host's localhost ports (core-api is on
# 127.0.0.1:8787). In that case leave this blank; your host connector has its
# own credentials. See the self-host guide's "bring your own connector" note.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# ── Email transport selector ─────────────────────────────────────────────────
# `smtp` for real delivery, `log` to write outgoing mail to the container log
# (dev / smoke tests only).
EMAIL_SENDER=smtp

# ── Client version compatibility (optional overrides) ────────────────────────
RECOMMENDED_CLIENT_VERSION=
MIN_CLIENT_VERSION=

# ── SpacetimeDB service identity (plan 1.5) ──────────────────────────────────
# Bootstrap once after module-init publishes: run `spacetime login show --token`
# inside the module-init service (which mounts its persisted publisher identity),
# copy the reported token below, then recreate core-api. See DEPLOYMENT.md.
# REQUIRED after the first start: without it core-api cannot pin its OIDC
# issuer into the module (anyone could create chat accounts over the public
# WebSocket), sync the admin role, revoke disabled accounts, or clean up
# attachments. Set it before anyone signs in.
SPACETIMEDB_HTTP_URL=http://spacetimedb:3000
SPACETIMEDB_SERVICE_TOKEN=


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║   FIRST-RUN DEFAULTS — ignored once /admin/config has the row             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Registration policy ──────────────────────────────────────────────────────
# Seed values for the runtime SystemConfig row. After first start, change
# these in /admin/config — edits here have no effect on a running deployment.
REQUIRE_EMAIL_CONFIRMATION=true
REQUIRE_ADMIN_APPROVAL=false

# ── Email (SMTP) connection details ──────────────────────────────────────────
# Required at first start when EMAIL_SENDER=smtp. After first start, manage
# these via /admin/config → Email / SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=LetsChat

# ── Rate limiting (per IP, per window, on auth endpoints) ────────────────────
# Counted separately for registration, email, and password requests; sign-in
# allows 10x this (failed passwords also lock the account).
RATE_LIMIT_PERMIT=10
RATE_LIMIT_WINDOW_SECONDS=300
