@page "/admin/config"
@model ConfigModel
@{
    ViewData["Title"] = "Configuration";
}

<h1 class="page-title">System configuration</h1>
<p class="page-sub">
    Runtime settings. Changes take effect immediately and are recorded in the audit log.
    These values were seeded from the deployment's <code>.env</code> file on first start —
    edits here override that, and further <code>.env</code> changes to the same fields are ignored.
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-error">@Model.Error</div>
}

<form method="post" id="config-form">
    <div class="card">
        <h2>Spaces</h2>
        <p class="hint" style="margin-top:0">
            Who can call <code>create_server</code> on the SpacetimeDB module. Lives in
            the chat-domain database, not the runtime <code>SystemConfig</code> row.
        </p>
        @if (!Model.SpacetimeWriteEnabled)
        {
            <div class="alert alert-error" style="margin-bottom:14px">
                <strong>Read-only.</strong> core-api has no module-owner credential yet, so
                this form can't push changes to SpacetimeDB. With the shipped compose file it
                reads it automatically from module-init's volume once the module is
                published; if this stays, check <code>docker logs letschat-module-init</code>
                and that the <code>module_init_home</code> volume is mounted into core-api.
            </div>
        }
        <div class="field">
            <label>Space creation policy</label>
            <div class="check">
                <input type="radio" id="sccp-anyone" name="SpaceCreatePolicy" value="Anyone"
                       checked="@(Model.SpaceCreatePolicy == "Anyone")"
                       disabled="@(!Model.SpacetimeWriteEnabled)">
                <label for="sccp-anyone">Anyone — any signed-in user can create spaces (default)</label>
            </div>
            <div class="check">
                <input type="radio" id="sccp-admins" name="SpaceCreatePolicy" value="AdminsOnly"
                       checked="@(Model.SpaceCreatePolicy == "AdminsOnly")"
                       disabled="@(!Model.SpacetimeWriteEnabled)">
                <label for="sccp-admins">Admins only — only users with <code>is_admin = true</code> on the SpacetimeDB <code>User</code> row</label>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Registration</h2>
        <div class="field check">
            <input type="checkbox" id="ro" name="RegistrationOpen" value="true" checked="@Model.RegistrationOpen">
            <label for="ro">Allow new self-registration</label>
        </div>
        <div class="field check">
            <input type="checkbox" id="rec" name="RequireEmailConfirmation" value="true" checked="@Model.RequireEmailConfirmation">
            <label for="rec">Require email confirmation before sign-in</label>
        </div>
        <div class="field check">
            <input type="checkbox" id="raa" name="RequireAdminApproval" value="true" checked="@Model.RequireAdminApproval">
            <label for="raa">Require admin approval after email confirmation</label>
        </div>
        <p class="hint">Admin approval only applies when email confirmation is enabled.</p>
    </div>

    <div class="card">
        <h2>Rate limiting</h2>
        <p class="hint" style="margin-top:0">Per-IP limit, counted separately for registration, email, and password requests. Sign-in allows 10× this, since failed passwords already lock the account.</p>
        <div class="field">
            <label for="rlp">Requests allowed per window</label>
            <input class="input" type="number" min="1" id="rlp" name="RateLimitPermitLimit" value="@Model.RateLimitPermitLimit">
        </div>
        <div class="field">
            <label for="rlw">Window length (seconds)</label>
            <input class="input" type="number" min="1" id="rlw" name="RateLimitWindowSeconds" value="@Model.RateLimitWindowSeconds">
        </div>
    </div>

    <div class="card">
        <h2>File uploads</h2>
        <p class="hint" style="margin-top:0">Limits for new uploads. Existing upload sessions keep their original part size.</p>
        <div class="field">
            <label for="ups">Multipart part size (MiB)</label>
            <input class="input" type="number" min="5" max="90" id="ups" name="UploadPartSizeMiB" value="@Model.UploadPartSizeMiB">
        </div>
        <div class="field">
            <label for="umf">Maximum file size (MiB)</label>
            <input class="input" type="number" min="5" max="2048" id="umf" name="UploadMaxFileSizeMiB" value="@Model.UploadMaxFileSizeMiB">
        </div>
        <div class="field">
            <label for="udq">Daily upload allowance per user (MiB, UTC day)</label>
            <input class="input" type="number" min="1" id="udq" name="DailyUploadQuotaMiB" value="@Model.DailyUploadQuotaMiB">
        </div>
        <div class="field">
            <label for="uus">Stored files per user (MiB)</label>
            <input class="input" type="number" min="0" id="uus" name="UserStorageLimitMiB" value="@Model.UserStorageLimitMiB">
            <div class="hint">0 means unlimited. Pending uploads reserve space; deleting a file releases it after storage cleanup succeeds.</div>
        </div>
        <div class="field">
            <label for="uis">Stored files across this installation (MiB)</label>
            <input class="input" type="number" min="0" id="uis" name="InstanceStorageLimitMiB" value="@Model.InstanceStorageLimitMiB">
            <div class="hint">0 means unlimited. This counts objects in this MinIO bucket, not free space on the underlying volume.</div>
        </div>
        @if (Model.InstanceStoredAndPendingBytes is { } usedBytes)
        {
            <p class="hint">Currently tracked across this installation: @((usedBytes / (1024.0 * 1024)).ToString("N1")) MiB, including pending uploads.</p>
        }
        else
        {
            <p class="hint">Storage inventory is still loading; usage is not available yet.</p>
        }
        <p class="hint">Browser downloads currently buffer the whole file in memory. Raising this limit can strain clients until download streaming/resume is implemented.</p>
    </div>

    <div class="card">
        <h2>Email / SMTP</h2>
        <div class="field">
            <label for="sh">SMTP host</label>
            <input class="input" id="sh" name="SmtpHost" value="@Model.SmtpHost">
        </div>
        <div class="field">
            <label for="sp">SMTP port</label>
            <input class="input" type="number" min="1" id="sp" name="SmtpPort" value="@Model.SmtpPort">
        </div>
        <div class="field">
            <label for="su">SMTP username</label>
            <input class="input" id="su" name="SmtpUser" value="@Model.SmtpUser" autocomplete="off">
        </div>
        <div class="field">
            <label for="spw">SMTP password</label>
            <input class="input" type="password" id="spw" name="SmtpPassword" autocomplete="new-password"
                   placeholder="@(Model.SmtpPasswordSet ? "•••••••• (leave blank to keep)" : "(not set)")">
            <div class="hint">Leave blank to keep the current password.</div>
        </div>
        <div class="field check">
            <input type="checkbox" id="tls" name="SmtpUseStartTls" value="true" checked="@Model.SmtpUseStartTls">
            <label for="tls">Use STARTTLS</label>
        </div>
        <div class="field">
            <label for="fa">From address</label>
            <input class="input" id="fa" name="EmailFromAddress" value="@Model.EmailFromAddress">
        </div>
        <div class="field">
            <label for="fn">From name</label>
            <input class="input" id="fn" name="EmailFromName" value="@Model.EmailFromName">
        </div>
    </div>

    <div class="form-actions" id="save-bar" hidden>
        <span class="muted small">Unsaved changes</span>
        <button type="submit" class="btn btn-primary">Save configuration</button>
    </div>
</form>

<script>
    // Show the floating save chip only while the form differs from how it loaded.
    (function () {
        var form = document.getElementById('config-form');
        var bar = document.getElementById('save-bar');
        if (!form || !bar) return;

        function snapshot() {
            var parts = [];
            new FormData(form).forEach(function (value, key) {
                if (key !== '__RequestVerificationToken') parts.push(key + '=' + value);
            });
            return parts.sort().join('&');
        }

        var baseline = snapshot();
        function refresh() { bar.hidden = snapshot() === baseline; }

        form.addEventListener('input', refresh);
        form.addEventListener('change', refresh);

        // A server-side validation error means there are pending edits to fix.
        if (document.querySelector('.alert-error')) bar.hidden = false;
    })();
</script>
