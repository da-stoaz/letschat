@model bool
@if (Model)
{
    <div id="desktop-downloads" class="cta" aria-label="Desktop downloads">
        <a class="btn btn-secondary" data-download="macos" href="/downloads/macos">Get the app for macOS</a>
        <a class="btn btn-secondary" data-download="windows" href="/downloads/windows">Get the app for Windows</a>
        <a class="btn btn-secondary" data-download="linux" href="/downloads/linux">Get the app for Linux</a>
    </div>
}
else
{
    <span class="btn btn-secondary" aria-disabled="true" title="No installer hosted on this instance.">
        Download coming soon
    </span>
}

<script>
    (function () {
        var ua = (navigator.userAgent || '').toLowerCase();
        // Mobile and unknown platforms keep all desktop choices visible.
        var mobile = /android|iphone|ipad|ipod|mobile/.test(ua) ||
            (/mac/.test(ua) && navigator.maxTouchPoints > 1);
        var os = mobile ? null : /mac/.test(ua) ? 'macos' :
            /win/.test(ua) ? 'windows' : /linux/.test(ua) ? 'linux' : null;
        if (os) {
            var match = document.querySelector('[data-download="' + os + '"]');
            if (match) match.classList.add('btn-primary');
        }
    })();
</script>
